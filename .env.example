# Backend
PORT=3001
JWT_SECRET=change-this-to-a-long-random-string-in-production

# PostgreSQL (required)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_secure_password
PGDATABASE=sadarproperties

# Google OAuth (optional but recommended)
# Create at https://console.cloud.google.com/apis/credentials
# Add Authorized redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Facebook Login (optional)
# Create app at https://developers.facebook.com/ and enable Facebook Login
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3001/api/auth/facebook/callback

# Frontend origin (for OAuth redirects after login)
FRONTEND_URL=http://localhost:5173

# Resend (required for email notifications to buyers/investors)
# Get your API key at https://resend.com/api-keys
# Verify your domain at https://resend.com/domains
RESEND_API_KEY=
RESEND_FROM=Sadar Properties <deals@yourdomain.com>

# AI for buy box extraction (optional - falls back to smart rules if missing)
# Gemini (Google) - recommended
GEMINI_API_KEY=
# OpenAI fallback
OPENAI_API_KEY=
# Or Grok / xAI
# GROK_API_KEY=

# Playwright is used for deeper LinkedIn/website scraping in AI extraction (already in deps)
# Run once: npx playwright install chromium
